{
  "name": "@tforster/halloween",
  "version": "2025.0.0",
  "description": "Halloween Lightning & Thunder Effect - Raspberry Pi Pico 2 with synchronised LED and audio effects",
  "homepage": "https://github.com/tforster/halloween#readme",
  "bugs": {
    "url": "https://github.com/tforster/halloween/issues"
  },
  "license": "MIT",
  "author": "Troy Forster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tforster/halloween.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "audio:prep": "python devops/prepare_audio.py",
    "audio:prep:dry": "python devops/prepare_audio.py --dry-run",
    "lint:py": "ruff check devops/",
    "format:py": "black devops/",
    "test:py": "pytest",
    "type:py": "venv/bin/mypy devops/",
    "wiring": "wireviz -f s docs/reference/assets/wiring.yml",
    "serve": "devops/serve.sh",
    "serve:stop": "devops/serve.sh --stop",
    "run": "devops/run.sh",
    "run:repl": "devops/run.sh --repl",
    "deploy": "devops/deploy.sh",
    "simulate": "devops/simulate.sh",
    "typecheck": "tsc -p jsconfig.json && npm run type:py"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  }
}
